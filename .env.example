# ============================================================
# 极光AIGC · 社媒爆款深挖系统 —— 环境配置模板
# 复制本文件为 .env 并填写你自己的 API（.env 不要提交/转发）
#   Windows: copy .env.example .env
# ============================================================

# ---------- 大模型 API（必填，任选一家，全部兼容） ----------
# 只需填下面 3 项，任意 OpenAI 兼容大模型都行：
#
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   月之暗面 Kimi  LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   阿里通义千问    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱 GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   豆包(火山方舟)  LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=ep-xxx
#   本地 Ollama     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen3:8b
#
# 申请地址：各厂商开放平台注册即可（DeepSeek/Kimi/通义/GLM 都有免费额度）

LLM_API_KEY=sk-把你的key填在这里
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 旧版兼容：只填 ZHIPU_API_KEY 也会被识别（不推荐，建议用上面三件套）
# ZHIPU_API_KEY=

# ---------- 小红书爬虫（必填，首次需扫码） ----------
# 不需要填任何 key。MediaCrawler 首次运行会弹浏览器，用你自己小红书账号扫码登录，
# 登录态会缓存在本地，之后自动复用。爬取范围由 pipeline/competitor_targets.json 控制。

# ---------- 以下全部可选，默认不启用 ----------

# 飞书多维表格（可选：不填则只产出本地文件，不推送飞书；后续版本再启用）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BASE_TOKEN=
