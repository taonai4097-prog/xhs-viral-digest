# ============================================================
# 社媒爆款深挖系统 —— 环境配置模板
# 复制本文件为 .env 并填写你自己的 API（.env 不要提交/转发）
#   Windows: copy .env.example .env
# ============================================================

# ---------- 大模型 API（必填，任选一家，全部兼容） ----------
# 只需填下面 3 项，任意 OpenAI 兼容大模型都行：
#
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   月之暗面 Kimi  LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   阿里通义千问    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   智谱 GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash
#   豆包(火山方舟)  LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=ep-xxx
#   本地 Ollama     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen3:8b
#
# 申请地址：各厂商开放平台注册即可（DeepSeek/Kimi/通义/GLM 都有免费额度）

LLM_API_KEY=sk-把你的key填在这里
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 旧版兼容：只填 ZHIPU_API_KEY 也会被识别（不推荐，建议用上面三件套）
# ZHIPU_API_KEY=

# ---------- 账号定位（可选，不填则用中性默认值） ----------
# ACCOUNT_NAME=你的账号昵称
# ACCOUNT_PERSONA=一句话介绍你的账号人设
# ACCOUNT_AUDIENCE=你的目标受众
# ACCOUNT_DESC=给大模型看的完整账号定位描述（覆盖 digest/文案生成）

# ---------- 小红书爬虫（必填，首次需扫码） ----------
# 不需要填任何 key。MediaCrawler 首次运行会弹浏览器，用你自己小红书账号扫码登录，
# 登录态会缓存在本地，之后自动复用。爬取范围由 pipeline/competitor_targets.json 控制。

# ---------- 以下全部可选，默认不启用 ----------

# ---------- 生图（不配也能跑：自动降级为「只出提示词」） ----------
# 生图可插拔：配了 API 就自动出图；没配就只生成「运营提示词卡片」，
# 由运营复制提示词去豆包 / 即梦等免费网站生成（新手推荐先走这条路）。
#
# IMAGE_PROVIDER=auto    # auto(默认) | prompt_only | openai | pollinations | cogview
#
# 想全自动出图，填下面三行（任意 OpenAI 兼容图像接口都行）：
#   OpenAI         IMAGE_API_BASE=https://api.openai.com/v1                 IMAGE_MODEL=gpt-image-1
#   硅基流动        IMAGE_API_BASE=https://api.siliconflow.cn/v1             IMAGE_MODEL=Kwai-Kolors/kolors
#   火山方舟(豆包)   IMAGE_API_BASE=https://ark.cn-beijing.volces.com/api/v3  IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
#
# IMAGE_API_KEY=          # 留空则回退用上面的 LLM_API_KEY
# IMAGE_API_BASE=
# IMAGE_MODEL=
# IMAGE_SIZE=1024x1536    # 可选，默认按平台比例推导（3:4 -> 1024x1536）
# 品牌风格锁：走账号级 accounts/<id>/brand.json（每号独立隔离，无全局 IMAGE_BRAND）
#   生成：python pipeline/brand_analyzer.py analyze --account <id> --cover-dir <该号封面目录>

# 飞书多维表格（可选：不填则只产出本地文件，不推送飞书；后续版本再启用）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_BASE_TOKEN=
