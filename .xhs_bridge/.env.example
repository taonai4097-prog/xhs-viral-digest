# 桥接服务配置（复制为 .env，勿提交真实 .env）
BRIDGE_PORT=18070

# playwright 路径：留空则自动探测 ../.pw_test/node_modules/playwright 或全局
# PLAYWRIGHT_PATH=

# 登录态 cookie 文件（真机导出后落盘此处；沙箱 headless 扫码被风控，必须走真机 cookie 导入）
COOKIE_FILE=xhs_cookies.json
QR_FILE=xhs_qr.png

CREATOR_URL=https://creator.xiaohongshu.com/publish/publish?source=official&target=image

# 无头模式（服务器/容器固定 true）
BRIDGE_HEADLESS=true
BROWSER_ARGS=--no-sandbox

REQUEST_TIMEOUT_MS=60000

# 生产请将 * 改为具体前端域名
CORS_ORIGIN=*

BRIDGE_LOG_LEVEL=info

# 真机 cookie 导入目录（P0b 规模化）：把从真机导出的 cookies.json 丢这里，服务采用最新一份
# COOKIE_IMPORT_DIR=
